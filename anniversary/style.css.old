:root {
  --soft-pink: #F8DDE5;
  --blush-pink: #F2C6D4;
  --cream: #FFF9F5;
  --white: #FFFFFF;
  --rose-brown: #A77B83;
  --dark-brown: #59434A;
  --text-primary: #333333;
  --text-secondary: #666666;
}

/* BASE STYLES */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Poppins', sans-serif;
  background-color: var(--cream);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
}

* {
  box-sizing: border-box;
}

h1, h2, h3, h4 {
  font-family: 'Playfair Display', serif;
  margin: 0;
  line-height: 1.3;
}

p {
  font-family: 'Cormorant Garamond', serif;
  margin: 0 0 1.5rem;
  font-style: italic;
  line-height: 1.8;
}

.button {
  font-family: 'Poppins', sans-serif;
  font-weight: 500;
  padding: 12px 28px;
  border: none;
  border-radius: 30px;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.btn-primary {
  background: var(--rose-brown);
  color: var(--white);
}

.btn-primary:hover {
  background: var(--dark-brown);
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(89, 67, 74, 0.2);
}

.btn-secondary {
  background: transparent;
  color: var(--rose-brown);
  border: 2px solid var(--rose-brown);
}

.btn-secondary:hover {
  background: var(--soft-pink);
  color: var(--rose-brown);
}

/* FLOATING HEARTS */
#floating-hearts {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
}

.heart {
  position: absolute;
  color: var(--rose-brown);
  font-size: 1.5rem;
  animation: float-heart 8s infinite ease-in-out;
}

@keyframes float-heart {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    opacity: 1;
  }
  50% {
    transform: translateY(-30px) rotate(15deg);
    opacity: 0.7;
  }
}

/* FLOWER PETALS */
#flower-petals {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 99;
}

.flower {
  position: absolute;
  font-size: 1.8rem;
  animation: drift-leaf 6s infinite linear;
  opacity: 0.8;
}

@keyframes drift-leaf {
  0% {
    transform: translateX(0) translateY(0) rotate(0deg);
  }
  100% {
    transform: translateX(100vw) translateY(100vh) rotate(360deg);
  }
}

/* OPENING PAGE */
.opening-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: linear-gradient(135deg, var(--soft-pink), var(--blush-pink));
  padding: 20px;
}

.small-text {
  font-family: 'Allura', cursive;
  font-size: 0.8rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--rose-brown);
  margin-bottom: 20px;
  opacity: 0;
  animation: fadeIn 1s ease forwards 0.5s;
}

.main-title {
  font-size: 3.5rem;
  font-weight: 700;
  color: var(--dark-brown);
  margin-bottom: 10px;
  opacity: 0;
  animation: fadeIn 1s ease forwards 0.7s;
}

.sub-title {
  font-size: 1.3rem;
  color: var(--dark-brown);
  margin-bottom: 30px;
  opacity: 0;
  animation: fadeIn 1s ease forwards 0.8s;
}

.dates {
  font-size: 1.1rem;
  color: var(--rose-brown);
  margin-bottom: 40px;
  opacity: 0;
  animation: fadeIn 1s ease forwards 0.9s;
}

.open-gift-btn {
  padding: 15px 40px;
  font-size: 1.1rem;
  opacity: 0;
  animation: fadeIn 1s ease forwards 1s;
}

/* HERO SECTION */
.hero-section {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 100px 20px 50px;
  position: relative;
}

.hero-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' style='fill:none;stroke:%23A77B83;stroke-width:1'/%3E%0A%3C/svg%3E") repeat;
  opacity: 0.3;
  pointer-events: none;
}

.hero-title {
  font-size: 4rem;
  font-weight: 700;
  color: var(--dark-brown);
  margin-bottom: 20px;
  opacity: 0;
  animation: fadeInUp 1s ease forwards;
}

.hero-sub {
  font-size: 1.5rem;
  color: var(--rose-brown);
  margin-bottom: 40px;
  opacity: 0;
  animation: fadeInUp 1s ease forwards 0.2s;
}

.hero-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.2rem;
  max-width: 600px;
  margin: 0 auto 50px;
  color: var(--dark-brown);
  line-height: 1.8;
  opacity: 0;
  animation: fadeIn 1s ease forwards 0.4s;
}

.hero-quote::before,
.hero-quote::after {
  content: '"';
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  color: var(--rose-brown);
  line-height: 1;
}

.hero-quote::before {
  content: open-quote;
  position: absolute;
  left: -20px;
}

.hero-quote::after {
  content: close-quote;
  position: absolute;
  right: -20px;
}

.anniversary-date {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 30px;
  opacity: 0;
  animation: fadeIn 1s ease forwards 0.6s;
}

.anniversary-date span {
  font-family: 'Playfair Display', serif;
  font-size: 0.9rem;
  color: var(--rose-brown);
}

.small-flower-decoration span {
  font-size: 1.5rem;
  margin: 0 5px;
}

/* ANIMATIONS */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.small-flower-decoration span {
  font-size: 1.5rem;
  margin: 0 5px;
}

/* ANIMATIONS */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-40px); }
  to { opacity: 1; transform: translateY(0); }
}

/* OUR STORY SECTION */
.our-story-section {
  padding: 100px 20px;
  background: var(--white);
  position: relative;
}

.our-story-section::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(248, 221, 229, 0.3), rgba(242, 198, 212, 0.3));
  pointer-events: none;
  z-index: 0;
}

.our-story-section > .container {
  position: relative;
  z-index: 1;
}

.story-dates {
  font-family: 'Playfair Display', serif;
  font-size: 0.9rem;
  color: var(--rose-brown);
  margin-bottom: 40px;
}

.story-dates strong {
  color: var(--dark-brown);
  margin-right: 20px;
}

.story-started {
  font-size: 1.1rem;
  color: var(--text-secondary);
  max-width: 600px;
  margin: 0 auto;
}

.timeline-container {
  position: relative;
  width: 100%;
  max-width: 800px;
  margin: 60px auto 0;
}

.timeline-container::before {
  content: '';
  position: absolute;
  top: 40px;
  left: 50%;
  width: 2px;
  height: 100%;
  background: var(--rose-brown);
  transform: translateX(-50%);
}

.timeline-point {
  position: absolute;
  top: 0;
  left: 50%;
  width: 20px;
  height: 20px;
  background: var(--rose-brown);
  border-radius: 50%;
  transform: translateX(-50%);
  z-index: 1;
  border: 4px solid var(--white);
}

/* LETTER SECTION */
.letter-section {
  padding: 100px 20px;
  background: var(--cream);
  position: relative;
}

.letter-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' style='fill:%23A77B83'/%3E%0A%3C/svg%3E") repeat;
  opacity: 0.3;
  pointer-events: none;
  z-index: 0;
}

.letter-section > .container {
  position: relative;
  z-index: 1;
  max-width: 800px;
  margin: 0 auto;
}

.letter-wrapper {
  background: var(--white);
  padding: 40px 50px;
  border-radius: 8px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  position: relative;
  margin: 0 auto;
}

.letter-title {
  font-size: 2.5rem;
  color: var(--dark-brown);
  margin-bottom: 10px;
  text-align: center;
}

.letter-subtitle {
  font-size: 1.1rem;
  color: var(--rose-brown);
  margin-bottom: 40px;
  text-align: center;
  font-style: normal;
  font-weight: normal;
}

/* Letter content animation */
.letter-content {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  line-height: 2.2;
  color: var(--text-primary);
  font-size: 1.1rem;
  text-align: left;
  white-space: pre-line;
  min-height: 400px;
}

.letter-content::first-letter {
  font-size: 3rem;
  float: left;
  line-height: 1;
  margin-right: 10px;
  font-family: 'Playfair Display', serif;
  color: var(--rose-brown);
}

.read-again-btn {
  display: block;
  width: fit-content;
  margin: 40px auto 0;
  padding: 10px 25px;
  font-size: 0.9rem;
}

/* LITTLE MEMORIES SECTION */
.memories-section {
  padding: 100px 20px;
  background: var(--white);
  position: relative;
}

.memories-section::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(248, 221, 229, 0.3), transparent);
  pointer-events: none;
  z-index: 0;
}

.memories-section > .container {
  position: relative;
  z-index: 1;
}

.section-title {
  font-size: 2.5rem;
  color: var(--dark-brown);
  margin-bottom: 10px;
  text-align: center;
}

.section-subtitle {
  font-size: 1.1rem;
  color: var(--rose-brown);
  margin-bottom: 60px;
  text-align: center;
  font-style: normal;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.photo-slot {
  position: relative;
  border-radius: 15px;
  overflow: hidden;
  background: var(--soft-pink);
}

.photo-image {
  width: 100%;
  height: 250px;
}

.photo-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.photo-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 15px;
  background: var(--cream);
  color: var(--dark-brown);
  font-size: 0.85rem;
  text-align: center;
}

/* Hover effect */
.photo-slot:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}

/* Lightbox Overlay */
.lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.lightbox img {
  max-width: 90%;
  max-height: 90%;
  object-fit: contain;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.lightbox .close {
  position: absolute;
  top: 20px;
  right: 30px;
  color: white;
  font-size: 2rem;
  font-weight: bold;
  cursor: pointer;
  transition: color 0.3s;
}

.lightbox .close:hover {
  color: #ff5f57;
}

/* SPECIAL MESSAGE SECTION */
.special-message-section {
  padding: 100px 20px;
  background: var(--soft-pink);
  position: relative;
  text-align: center;
}

.special-message-section::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200px;
  height: 200px;
  background: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill='%23A77B83' d='M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5.09C10.9 5.84 14 8.34 14 11.5c0 3.94-2.86 7-6.5 7-1.86 0-3.56-1.07-4.56-2.63C3.6 19.78 2 16.49 2 12.5 2 8.58 4.42 5.12 7.5.09C10.9 8.16 14 10.66 14 13.5c0 1.32-.17 2.58-.45 3.65l.36.33z'/%3E%3C/svg%3E");
  opacity: 0.5;
  pointer-events: none;
}

.special-message-section > .container {
  position: relative;
  z-index: 1;
  max-width: 600px;
  margin: 0 auto;
}

.message-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.5rem;
  color: var(--dark-brown);
  margin-bottom: 40px;
  line-height: 1.8;
}

.heart-decoration {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 30px;
  flex-wrap: wrap;
}

.heart-decoration span {
  color: var(--rose-brown);
  font-size: 1.2rem;
  animation: gentlePulse 3s infinite ease-in-out;
}

@keyframes gentlePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* FINAL SECTION */
.final-section {
  padding: 100px 20px;
  background: var(--white);
  position: relative;
  text-align: center;
}

.final-section::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(248, 221, 229, 0.5), transparent);
  pointer-events: none;
  z-index: 0;
}

.final-section > .container {
  position: relative;
  z-index: 1;
  max-width: 600px;
  margin: 0 auto;
}

.final-text {
  font-family: 'Playfair Display', serif;
  font-size: 3rem;
  color: var(--dark-brown);
  margin-bottom: 20px;
}

.final-with-love {
  font-family: 'Poppins', sans-serif;
  font-size: 1.1rem;
  color: var(--rose-brown);
  margin-bottom: 10px;
}

.final-name {
  font-family: 'Allura', cursive;
  font-size: 2rem;
  color: var(--rose-brown);
  margin-bottom: 20px;
}

.final-date {
  font-size: 0.9rem;
  color: var(--rose-brown);
  margin-bottom: 40px;
}

.read-again-final-btn {
  padding: 12px 30px;
  font-size: 0.9rem;
}

/* RESPONSIVE DESIGN */
@media (max-width: 768px) {
  .main-title {
    font-size: 2.5rem;
  }
  
  .hero-title {
    font-size: 2.5rem;
  }
  
  .hero-quote {
    font-size: 1rem;
  }
  
  .letter-wrapper {
    padding: 30px 30px;
  }
  
  .letter-title {
    font-size: 2rem;
  }
  
  .gallery-grid {
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }
  
  .photo-slot {
    margin: 0 5px;
  }
  
  .final-text {
    font-size: 2rem;
  }
}

/* TYPOGRAPHY */
h1, h2, h3, h4 {
  font-family: 'Playfair Display', serif;
  margin: 0;
  line-height: 1.3;
}

p {
  font-family: 'Cormorant Garamond', serif;
  margin: 0 0 1.5rem;
  font-style: italic;
  line-height: 1.8;
}

